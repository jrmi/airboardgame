# Airboardgame backend port and host
# Change this if you need external access
SERVER_PORT=4050
SERVER_HOST=localhost

# MongoDB is the planned persistent backend
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=airboardgame

# Compatibility configuration for the current NeDB deployment.
#STORE_BACKEND=nedb
#NEDB_BACKEND_DIRNAME=/path/to/airDB

# Used to sign the HTTP-only session cookie
RICOCHET_SECRET=YourSuperSecretHere

# Optional disk media directory
#DISK_DESTINATION=/path/to/dir/

# Optional S3 settings. The replacement backend currently reads disk media;
# S3 support must be added before selecting an S3 bucket here.
#S3_ACCESS_KEY=<existing-s3-access-key>
#S3_SECRET_KEY=<existing-s3-secret-key>
#S3_ENDPOINT=<existing-s3-endpoint>
#S3_BUCKET=<existing-s3-bucket>
#S3_REGION=<existing-s3-region>

# Smtp server configuration
# If you let the fake host, sent mails are displayed in the console.
EMAIL_HOST=fake
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# Socket.IO uses the same process as the HTTP backend
SOCKET_PATH=/socket.io

# Webconference Openvidu configuration
# You need to enable webconference on the frontend also
# See https://docs.openvidu.io for more information
OPENVIDU_URL=
OPENVIDU_SECRET=

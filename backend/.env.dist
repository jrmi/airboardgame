# Airboardgame backend port and host
# Change SERVER_HOST if you need external access.
SERVER_PORT=4050
CLIENT_URL=http://localhost:3001
SERVER_HOST=localhost

# The default local setup uses NeDB and stores JSON data under backend/data/db.
# Use an absolute path when running the backend from a different directory.
STORE_BACKEND=nedb
NEDB_BACKEND_DIRNAME=./data/db

# Game media is stored on the local filesystem under backend/data/media.
FILE_STORAGE=disk
DISK_DESTINATION=./data/media

# Alternative: use MongoDB for game data instead of NeDB.
#STORE_BACKEND=mongodb
#MONGODB_URI=mongodb://localhost:27017
#MONGODB_DATABASE=airboardgame

# Used to sign the HTTP-only session cookie. Keep this value stable.
ABG_SECRET=YourSuperSecretHere
# RICOCHET_SECRET is supported as a fallback for existing deployments.

# Alternative: use S3-compatible storage instead of local disk media.
#FILE_STORAGE=s3
#S3_ACCESS_KEY=<existing-s3-access-key>
#S3_SECRET_KEY=<existing-s3-secret-key>
#S3_ENDPOINT=<existing-s3-endpoint>
#S3_BUCKET=<existing-s3-bucket>
#S3_REGION=<existing-s3-region>
#S3_PROXY=1
#S3_CDN=https://cdn.example.com

# Smtp server configuration
# If you let the fake host, sent mails are displayed in the console.
EMAIL_HOST=fake
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=

# Socket.IO uses the same process as the HTTP backend
SOCKET_PATH=/socket.io

# Webconference Openvidu configuration
# You need to enable webconference on the frontend also
# See https://docs.openvidu.io for more information
OPENVIDU_URL=
OPENVIDU_SECRET=
